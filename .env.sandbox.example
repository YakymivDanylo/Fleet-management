# Sandbox (test) environment. Copy to .env.sandbox and fill in the values:
#   cp .env.sandbox.example .env.sandbox
# .env.sandbox is git-ignored; never commit real values.

APP_ENV=sandbox
# Verbose errors are allowed here; production refuses to start with DEBUG=true.
DEBUG=true

# --- docker compose: `docker compose -p fleet_sandbox --env-file .env.sandbox up -d --build`
COMPOSE_PROJECT_NAME=fleet_sandbox
# Starts the Toxiproxy fault-injection proxy (Lab 2); REDIS_URL below goes through it.
COMPOSE_PROFILES=fault
API_PORT=8000
RABBITMQ_MGMT_PORT=15672
TOXIPROXY_PORT=8474

# --- database (sandbox DB name must end with _sandbox)
POSTGRES_USER=fleet_sandbox_user
POSTGRES_PASSWORD=change-me-sandbox
POSTGRES_DB=fleet_sandbox

# --- message broker
RABBITMQ_DEFAULT_USER=fleet_sandbox_mq
RABBITMQ_DEFAULT_PASS=change-me-sandbox-mq

# --- application
REDIS_URL=redis://toxiproxy:26379/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# --- running the app on the host (outside compose); compose builds its own URLs
# DATABASE_URL=postgresql+asyncpg://fleet_sandbox_user:change-me-sandbox@localhost:5432/fleet_sandbox
# RABBITMQ_URL=amqp://fleet_sandbox_mq:change-me-sandbox-mq@localhost:5672/
