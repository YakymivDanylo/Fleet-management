    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100*(sum(rate(k6_http_reqs_total{run=~\"$run\",phase=\"load\",status!=\"200\"}[30s])) or vector(0))/sum(rate(k6_http_reqs_total{run=~\"$run\",phase=\"load\"}[30s]))",
     "legendFormat": "failed requests, %",
     "refId": "A"
    }
