   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
