# Environment-specific settings live in .env.sandbox.example and .env.production.example.
# Copy the one you need to .env.sandbox / .env.production (see docs/lab3-web-env-cicd.md).
# APP_ENV picks which file the app reads: APP_ENV=production -> .env.production,
# otherwise .env.sandbox. Real environment variables always take precedence.
APP_ENV=sandbox
SONAR_TOKEN=
