# Environment-specific settings live in .env.sandbox.example and .env.production.example.
# Copy the one you need to .env.sandbox / .env.production (see docs/lab3-web-env-cicd.md).
# APP_ENV picks which file the app reads: APP_ENV=production -> .env.production,
# otherwise .env.sandbox. Real environment variables always take precedence.
APP_ENV=sandbox
SONAR_TOKEN=

# --- one-command start (Lab 5): `docker compose up --build` reads .env automatically,
# so for that path copy these into .env with real values. Fresh project name = own volumes.
# COMPOSE_PROJECT_NAME=fleet_lab5
# DEBUG=false
# API_PORT=8000
# RABBITMQ_MGMT_PORT=15672
# POSTGRES_USER=fleet_lab5_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=fleet_lab5_sandbox
# RABBITMQ_DEFAULT_USER=fleet_lab5_mq
# RABBITMQ_DEFAULT_PASS=change-me
# JWT_SECRET_KEY=
