# Reference only (Lab 5, multi-stage comparison): the naive single-stage build that the
# real Dockerfile replaces. Full python image (gcc, headers), pip and build cache stay in.
#   docker build -f docs/lab5-docker/Dockerfile.single-stage -t fleet-api:single-stage .
FROM python:3.13
WORKDIR /app
COPY requirements.txt pyproject.toml ./
COPY src ./src
COPY alembic.ini .
COPY alembic ./alembic
RUN pip install -r requirements.txt && pip install --no-deps .
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn fleet_management.main:app --host 0.0.0.0 --port 8000"]
