# Production environment. Copy to .env.production on the server and fill in real values:
#   cp .env.production.example .env.production
# .env.production is git-ignored; never commit real values.

APP_ENV=production
# Must stay false: the app refuses to start in production with DEBUG=true.
DEBUG=false

# --- docker compose: `docker compose -p fleet_production --env-file .env.production up -d --build`
COMPOSE_PROJECT_NAME=fleet_production
# Different host ports let sandbox and production run side by side on one machine.
API_PORT=8080
RABBITMQ_MGMT_PORT=15673
TOXIPROXY_PORT=8475

# --- database (production DB name must end with _production)
POSTGRES_USER=fleet_production_user
POSTGRES_PASSWORD=
POSTGRES_DB=fleet_production

# --- message broker
RABBITMQ_DEFAULT_USER=fleet_production_mq
RABBITMQ_DEFAULT_PASS=

# --- application
REDIS_URL=redis://redis:6379/0
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- running the app on the host (outside compose); compose builds its own URLs
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/fleet_production
# RABBITMQ_URL=amqp://<user>:<password>@<host>:5672/
